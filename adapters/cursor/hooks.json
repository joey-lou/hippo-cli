{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "./hooks/hippo-session-start.sh", "timeout": 20 }
    ],
    "afterFileEdit": [
      { "command": "./hooks/hippo-after-file-edit.sh", "timeout": 30 }
    ],
    "stop": [
      { "command": "./hooks/hippo-stop.sh", "timeout": 15, "loop_limit": 1 }
    ]
  }
}
