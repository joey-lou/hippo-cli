{
  "root": "cursor",
  "links": [
    {"from": "hooks/hippo-session-start.sh", "to": "hooks/hippo-session-start.sh"},
    {"from": "hooks/hippo-after-file-edit.sh", "to": "hooks/hippo-after-file-edit.sh"},
    {"from": "hooks/hippo-after-shell.sh", "to": "hooks/hippo-after-shell.sh"},
    {"from": "hooks/hippo-sync-memory.sh", "to": "hooks/hippo-sync-memory.sh"},
    {"from": "hooks/hippo-stop.sh", "to": "hooks/hippo-stop.sh"},
    {"from": "skills/use-memory", "to": "skills/use-memory"}
  ],
  "hooks": [
    {
      "file": "hooks.json",
      "event": "sessionStart",
      "entry": {"command": "./hooks/hippo-session-start.sh", "timeout": 20}
    },
    {
      "file": "hooks.json",
      "event": "afterFileEdit",
      "entry": {"command": "./hooks/hippo-after-file-edit.sh", "timeout": 30}
    },
    {
      "file": "hooks.json",
      "event": "afterShellExecution",
      "entry": {
        "command": "./hooks/hippo-after-shell.sh",
        "matcher": "hippo\\s+(add|update|consolidate)\\b",
        "timeout": 30
      }
    },
    {
      "file": "hooks.json",
      "event": "stop",
      "entry": {"command": "./hooks/hippo-stop.sh", "timeout": 15, "loop_limit": 1}
    }
  ]
}
